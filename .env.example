# Flask
SECRET_KEY=change-me

# Database (SQLite locally; Postgres — e.g. Neon's free tier — in production)
DATABASE_URL=sqlite:///talentscope.db

# Gemini Q&A (ai/registry.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Email notifications (notifications/registry.py) — only needed if a user
# has "email" in their preferred channels
SMTP_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Telegram notifications — only needed if a user has "telegram" in their
# preferred channels
TELEGRAM_BOT_TOKEN=

# Public site URL, linked from the Telegram digest when there are more
# matches than fit in one message
SITE_URL=https://talentscope-pisc.onrender.com

# GitHub skill sync (workers/run_github_sync.py) — optional. Unauthenticated
# requests work fine at cohort scale (60 req/hr); set this to raise GitHub's
# rate limit to 5000 req/hr if the cohort grows.
GITHUB_TOKEN=

# Pipeline (workers/scheduler.py, workers/run_pipeline_once.py)
PIPELINE_SOURCES=internshala,remotive
PIPELINE_CRON=0 */2 * * *
